# Copy to .env and replace secrets before deploying.
#   cp .env.example .env && chmod 600 .env
#
# Compose expands $NAME and ${NAME} in unquoted and double-quoted values, here and in .env:
# write a literal '$' as '$$' (or single-quote the whole value). docs/deployment.md, section 10.
#
# Local development: keep settings_dev below (docker-compose.yml loads this file; the image
# itself defaults to settings_prod).
# Production: switch to settings_prod and fill the production block. Releases write
# the production .env from the GitHub environment `production` (application settings and
# secrets) and the server's /etc/odt/backend-host.env (everything else, such as UID, GID,
# HOST_*, *_IMAGE, COMPOSE_PROFILES, ports and DJANGO_SETTINGS_MODULE); docs/deployment.md,
# section 20.

POSTGRES_DB=otwarte_dane_transportowe
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# Seconds a gunicorn thread keeps its database connection open between requests;
# 0 = a new connection per request (docs/deployment.md, section 6).
# POSTGRES_CONN_MAX_AGE=60

DJANGO_SETTINGS_MODULE=OtwarteDaneTransportowe.settings_dev
# DJANGO_SECRET_KEY is intentionally NOT set here: without it, dev falls back
# to a built-in placeholder while settings_prod refuses to start. Set a strong
# value in .env (see the production block below).
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:44213
CORS_URLS_REGEX='^/(api|feed)/.*$'
# The website's refresh cookie is Secure (ADR 0017). Chrome and Firefox accept it on
# http://localhost; turn it off only for a browser that does not. Always on in settings_prod.
# AUTH_REFRESH_COOKIE_SECURE=false

# --- Production (uncomment / replace when deploying) -----------------------
# Use ./scripts/deploy.sh instead of plain docker compose (applies prod overlay).
# DJANGO_SETTINGS_MODULE=OtwarteDaneTransportowe.settings_prod
# DJANGO_SECRET_KEY=<generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))">
# DJANGO_ALLOWED_HOSTS=api.example.org
#   (127.0.0.1 and localhost are added automatically in settings_prod)
# DJANGO_SECURE_SSL_REDIRECT=False
#   (default in settings_prod; TLS is handled by nginx/Caddy)
# CSRF_TRUSTED_ORIGINS=https://api.example.org
# CORS_ALLOWED_ORIGINS=https://www.example.org,https://example.org
# FEED_AUTH_ENCRYPTION_KEY=<generate Fernet key — see docs/deployment.md>
#   (required: settings_prod refuses to start without a valid Fernet key)
# FEED_AUTH_ENCRYPTION_OLD_KEYS=<previous key(s), comma-separated, only during a rotation>
# UID=1000
# GID=1000
# HOST_PROJECT_PATH=/srv/odt-backend
# HOST_MEDIA_ROOT=/srv/odt-backend/uploaded_data
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=4

# Shared cache (Redis). Required in production for the realtime lock + throttling.
REDIS_CACHE_URL=redis://redis:6379/2

# Comma-separated trusted reverse-proxy CIDRs: X-Forwarded-For is honoured only from these,
# for the per-IP limits (blog reactions, login, feed downloads, planner). settings_prod
# refuses to start with it empty unless ALLOW_UNTRUSTED_PROXY_IPS=True.
# TRUSTED_PROXY_CIDRS=

# Redis password, empty in development. Production requires one (letters, digits, - and
# _ only: it goes into redis:// URLs). The production overlay publishes no Postgres or
# Redis port, so the two *_HOST_PORT settings are for development only.
REDIS_PASSWORD=
POSTGRES_HOST_PORT=5420
REDIS_HOST_PORT=6379
WEB_HOST_PORT=8000
# Bind address for the web port on the Docker host. Default 127.0.0.1 (localhost only;
# use with nginx/Caddy on the same machine). Set to 0.0.0.0 for LAN access, e.g.
# http://192.168.1.11:8020 — not recommended on a public-facing server without a firewall.
# WEB_HOST_BIND=0.0.0.0

CELERY_DEFAULT_CONCURRENCY=2
# Realtime fetches and verifications (each may take up to 90 s) run on their own worker,
# so they never hold back the dispatchers on the default queue.
CELERY_REALTIME_CONCURRENCY=2
# The feeds worker only runs static downloads and GTFS validations: a few jobs
# per feed per day. Each extra prefork child costs ~90 MB RSS while idle, and
# queued jobs simply wait their turn (the beat dispatchers run on 'default').
CELERY_FEEDS_CONCURRENCY=1

# Memory hygiene: recycle worker children so a large feed download does not
# raise a worker's RSS permanently (CPython keeps freed arenas resident).
# CELERY_WORKER_MAX_TASKS_PER_CHILD=50
# CELERY_WORKER_MAX_MEMORY_PER_CHILD=300000   # KiB
# CELERY_WORKER_PREFETCH_MULTIPLIER=1

# Container memory ceilings (docker-compose.yml mem_limit; see docs/deployment.md section 1).
# Raise the web and worker ones together with GUNICORN_WORKERS and the concurrencies above.
# WEB_MEM_LIMIT=1g
# CELERY_DEFAULT_MEM_LIMIT=1g
# CELERY_REALTIME_MEM_LIMIT=1g
# CELERY_FEEDS_MEM_LIMIT=1g
# CELERY_PLANNER_MEM_LIMIT=6g
# POSTGRES_MEM_LIMIT=1g

# Download caps. Static feeds stream to a temp file, so MAX_FEED_FILE_SIZE_BYTES
# bounds disk, not RAM. Realtime payloads ARE parsed in full and get a tighter cap.
# MAX_FEED_FILE_SIZE_BYTES=209715200
# MAX_REALTIME_FEED_BYTES=33554432
# FEED_FETCH_TOTAL_TIMEOUT_SECONDS=600
# REALTIME_FETCH_TOTAL_TIMEOUT_SECONDS=60

# GTFS validator worker talks to the Docker API via the docker-socket-proxy
# service (DOCKER_HOST is set in docker-compose.yml) — no host-specific
# configuration (previously DOCKER_GID) is needed anymore.
# Validator image; defaults to a pinned release. Bump deliberately, results
# can change between versions.
# GTFS_VALIDATOR_IMAGE=ghcr.io/mobilitydata/gtfs-validator:8.0.1
# Resource limits of the validator container (NANO_CPUS: 1000000000 = 1 core,
# default 2 cores, 0 = no CPU cap). It runs as UID:GID and mounts HOST_MEDIA_ROOT
# (see above).
# GTFS_VALIDATOR_MEM_LIMIT=2g
# GTFS_VALIDATOR_PIDS_LIMIT=512
# GTFS_VALIDATOR_NANO_CPUS=2000000000

# ── Journey planner (OpenTripPlanner) — see docs/deployment.md "Journey planner" ──
# Turn it on by adding the compose profile: COMPOSE_PROFILES=planner
# Shared secret OTP sends when it polls proxied realtime files from this app
# (exempts those polls from throttling). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# PLANNER_INTERNAL_TOKEN=
# Pinned OTP image: a graph only loads in the version that built it.
# PLANNER_OTP_IMAGE=opentripplanner/opentripplanner:2.10.0
# Graphs, snapshots and build workspaces (inside the containers / on the host).
# PLANNER_DATA_DIR=/app/planner_data
# HOST_PLANNER_DATA_DIR=/srv/odt-backend/planner_data
# OSM extract for the street graph, relative to PLANNER_DATA_DIR.
# PLANNER_OSM_FILE=osm/region.osm.pbf
# Largest OSM extract an admin may download from a URL (bytes; Poland ~2.1 GB).
# PLANNER_OSM_MAX_BYTES=4294967296
# Serving OTP (compose service `otp`): heap and container limit. Measured for
# all of Poland on cropped OSM: -Xmx6g fits in ~7 GB; 5g ran out under load.
# PLANNER_OTP_SERVE_HEAP=6g
# PLANNER_OTP_SERVE_MEM_LIMIT=7g
# Build containers run while the serving OTP is stopped; the heap may exceed
# the RAM limit and spill into swap (MEMSWAP = RAM + swap allowed). The JVM
# fills the whole heap, so a larger heap only costs swap: all of Poland needs
# ~6.6 GB live, and 14g was killed by earlyoom on the 11 GB VPS.
# PLANNER_OTP_BUILD_HEAP=10g
# PLANNER_OTP_BUILD_MEM_LIMIT=8g
# PLANNER_OTP_BUILD_MEMSWAP_LIMIT=22g
# PLANNER_OTP_FEED_TEST_HEAP=6g
# PLANNER_OTP_FEED_TEST_MEM_LIMIT=7g
# Raw request logs of the public planner API (with IP addresses) are deleted
# after this many days; daily statistics without IPs are kept (ADR 0010).
# PLANNER_REQUEST_LOG_RETENTION_DAYS=30
# Internal addresses (defaults match docker-compose.yml container names).
# PLANNER_OTP_CONTAINER=odt-otp
# PLANNER_OTP_URL=http://odt-otp:8080
# PLANNER_ODT_INTERNAL_URL=http://odt-web:8000
