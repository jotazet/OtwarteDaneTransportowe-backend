# Copy to .env and replace secrets before deploying.
#   cp .env.example .env && chmod 600 .env
#
# Secrets are loaded via env_file (not Compose ${VAR} interpolation), so passwords
# and keys may contain '$' without extra escaping.
#
# Local development: keep settings_dev below.
# Production: switch to settings_prod and fill the production block.

POSTGRES_DB=otwarte_dane_transportowe
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

DJANGO_SETTINGS_MODULE=OtwarteDaneTransportowe.settings_dev
# DJANGO_SECRET_KEY is intentionally NOT set here: without it, dev falls back
# to a built-in placeholder while settings_prod refuses to start. Set a strong
# value in .env (see the production block below).
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:44213
CORS_URLS_REGEX='^/(api|feed)/.*$'

# --- Production (uncomment / replace when deploying) -----------------------
# Use ./scripts/deploy.sh instead of plain docker compose (applies prod overlay).
# DJANGO_SETTINGS_MODULE=OtwarteDaneTransportowe.settings_prod
# DJANGO_SECRET_KEY=<generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))">
# DJANGO_ALLOWED_HOSTS=api.example.org
#   (127.0.0.1 and localhost are added automatically in settings_prod)
# DJANGO_SECURE_SSL_REDIRECT=False
#   (default in settings_prod; TLS is handled by nginx/Caddy)
# CSRF_TRUSTED_ORIGINS=https://api.example.org
# CORS_ALLOWED_ORIGINS=https://www.example.org,https://example.org
# FEED_AUTH_ENCRYPTION_KEY=<generate Fernet key — see docs/deployment.md>
# UID=1000
# GID=1000
# HOST_PROJECT_PATH=/opt/odt
# HOST_MEDIA_ROOT=/opt/odt/uploaded_data
# GUNICORN_WORKERS=3

# Public base URL of the API (scheme://host). Needed so the GTFS-RT validator
# can download PROXIED static feeds through /feed/... routes; without it,
# semantic GTFS-RT validation is skipped for proxied feeds.
# PUBLIC_BASE_URL=https://api.example.org

# Shared cache (Redis). Required in production for the realtime lock + throttling.
REDIS_CACHE_URL=redis://redis:6379/2

# Comma-separated trusted reverse-proxy CIDRs (blog reaction IP limiting).
# TRUSTED_PROXY_CIDRS=

POSTGRES_HOST_PORT=5420
REDIS_HOST_PORT=6379
WEB_HOST_PORT=8000
# Bind address for the web port on the Docker host. Default 127.0.0.1 (localhost only;
# use with nginx/Caddy on the same machine). Set to 0.0.0.0 for LAN access, e.g.
# http://192.168.1.11:8020 — not recommended on a public-facing server without a firewall.
# WEB_HOST_BIND=0.0.0.0

CELERY_DEFAULT_CONCURRENCY=2
# The feeds worker only runs static downloads and GTFS validations: a few jobs
# per feed per day. Each extra prefork child costs ~90 MB RSS while idle, and
# queued jobs simply wait their turn (the beat dispatchers run on 'default').
CELERY_FEEDS_CONCURRENCY=1

# Memory hygiene: recycle worker children so a large feed download does not
# raise a worker's RSS permanently (CPython keeps freed arenas resident).
# CELERY_WORKER_MAX_TASKS_PER_CHILD=50
# CELERY_WORKER_MAX_MEMORY_PER_CHILD=300000   # KiB
# CELERY_WORKER_PREFETCH_MULTIPLIER=1

# Download caps. Static feeds stream to a temp file, so MAX_FEED_FILE_SIZE_BYTES
# bounds disk, not RAM. Realtime payloads ARE parsed in full and get a tighter cap.
# MAX_FEED_FILE_SIZE_BYTES=209715200
# MAX_REALTIME_FEED_BYTES=33554432
# FEED_FETCH_TOTAL_TIMEOUT_SECONDS=600
# REALTIME_FETCH_TOTAL_TIMEOUT_SECONDS=60

# GTFS validator worker talks to the Docker API via the docker-socket-proxy
# service (DOCKER_HOST is set in docker-compose.yml) — no host-specific
# configuration (previously DOCKER_GID) is needed anymore.
# Validator image; defaults to a pinned release. Bump deliberately, results
# can change between versions.
# GTFS_VALIDATOR_IMAGE=ghcr.io/mobilitydata/gtfs-validator:8.0.1
# Resource limits of the validator container (NANO_CPUS: 1000000000 = 1 core;
# unset = no CPU cap). It runs as UID:GID and mounts HOST_MEDIA_ROOT (see above).
# GTFS_VALIDATOR_MEM_LIMIT=2g
# GTFS_VALIDATOR_PIDS_LIMIT=512
# GTFS_VALIDATOR_NANO_CPUS=2000000000
