#!/bin/sh
# Deploys a release tag (docs/deployment.md, section 20); the deploy job runs it on the
# production runner. Installed by hand as /usr/local/sbin/odt-deploy, owned by root, and
# run through sudo as the user that owns the checkout: the runner may run nothing else.
#
#   odt-deploy vX.Y.Z < production.env
#
# Checks out the release tag, which must be on main, and hands it to that release's own
# scripts/deploy/release.sh together with the .env from standard input. Kept small so
# it rarely needs reinstalling; the steps of a deployment live in release.sh.
set -eu

# sudo resets the environment and sets HOME to the target user's home.
ODT_DIR="$HOME/OtwarteDaneTransportowe-backend"
REPOSITORY=https://github.com/jotazet/OtwarteDaneTransportowe-backend.git

tag="${1:-}"
if ! printf '%s\n' "$tag" | grep -Eqx 'v[0-9]+\.[0-9]+\.[0-9]+'; then
    echo "odt-deploy: expected a release tag vX.Y.Z, got '$tag'" >&2
    exit 2
fi

env_new="$(mktemp)"
trap 'rm -f "$env_new"' EXIT
cat > "$env_new"

cd "$ODT_DIR"
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    echo "odt-deploy: $ODT_DIR has local changes; commit or discard them first" >&2
    git status --short --untracked-files=no >&2
    exit 1
fi
git fetch --quiet --force "$REPOSITORY" \
    "refs/tags/$tag:refs/tags/$tag" "refs/heads/main:refs/remotes/origin/main"
if ! git merge-base --is-ancestor "refs/tags/$tag" refs/remotes/origin/main; then
    echo "odt-deploy: $tag is not on main" >&2
    exit 1
fi

echo "odt-deploy: $(git describe --tags --always HEAD) -> $tag"
git checkout --quiet --detach "refs/tags/$tag"
sh scripts/deploy/release.sh "$tag" "$env_new"
